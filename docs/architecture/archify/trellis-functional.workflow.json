{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Trellis Functional Learning Loop",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "trellis-functional.workflow.html",
    "views": [
      { "id": "learner-path", "label": "学习者主路径", "focus": ["learner", "situation", "map", "package", "context", "practice", "evidence", "adapt", "growth"], "note": "从模糊目标到可验证能力变化。" },
      { "id": "intelligence-path", "label": "智能判断链", "focus": ["situation", "sources", "map", "package", "adapt"], "note": "查看系统如何把输入转成下一最佳任务。" },
      { "id": "evidence-path", "label": "证据闭环", "focus": ["context", "practice", "evidence", "growth", "adapt"], "note": "查看学习活动如何产生能力信号并改变后续。" }
    ]
  },
  "lanes": [
    { "id": "learner_lane", "label": "学习者" },
    { "id": "trellis_lane", "label": "Trellis 编排" },
    { "id": "content_lane", "label": "内容与能力" },
    { "id": "evidence_lane", "label": "验证与成长", "variant": "exception" }
  ],
  "phases": [
    { "id": "orient", "label": "判断处境", "fromCol": 0, "toCol": 1 },
    { "id": "compose", "label": "编排任务", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "learn", "label": "学习与验证", "fromCol": 4, "toCol": 5 }
  ],
  "groups": [
    { "id": "content_understanding", "label": "内容理解", "lane": "content_lane", "fromCol": 1, "toCol": 3, "variant": "dashed" },
    { "id": "feedback_loop", "label": "证据反馈环", "lane": "evidence_lane", "fromCol": 4, "toCol": 5, "variant": "emphasis" }
  ],
  "mainPath": ["learner", "situation", "map", "package", "context", "practice", "evidence", "growth"],
  "semanticChecks": {
    "allowedRoots": ["learner"],
    "allowedTerminals": ["growth", "adapt"],
    "requiredPaths": [{ "from": "situation", "to": "package" }, { "from": "evidence", "to": "adapt" }]
  },
  "nodes": [
    { "id": "learner", "lane": "learner_lane", "col": 0, "type": "external", "label": "学习者", "sublabel": "目标、材料、时间与反馈", "width": 146 },
    { "id": "situation", "lane": "trellis_lane", "col": 1, "type": "backend", "label": "学习处境诊断", "sublabel": "目标假设 / 起点 / 不确定性", "tag": "不是照抄原话", "width": 156 },
    { "id": "sources", "lane": "content_lane", "col": 1, "type": "backend", "label": "来源理解", "sublabel": "课程、文章、帖子与零材料", "width": 150, "yOffset": 112 },
    { "id": "map", "lane": "content_lane", "col": 2, "type": "backend", "label": "知识与能力地图", "sublabel": "知识点 / 前置 / 分支 / 标准", "tag": "内容不是课程名", "width": 166 },
    { "id": "package", "lane": "trellis_lane", "col": 3, "type": "backend", "label": "下一最佳任务包", "sublabel": "本周使命 + 任务顺序 + 停止条件", "tag": "解释为什么现在做", "width": 170 },
    { "id": "context", "lane": "learner_lane", "col": 4, "type": "frontend", "label": "任务学习上下文", "sublabel": "片段、解释、参考与恢复状态", "width": 164 },
    { "id": "practice", "lane": "learner_lane", "col": 5, "type": "frontend", "label": "理解与练习", "sublabel": "场景题 / 复述 / 真实任务", "width": 160 },
    { "id": "evidence", "lane": "evidence_lane", "col": 5, "type": "backend", "label": "多信号验证", "sublabel": "答案、自评、作品与行为表现", "tag": "不以点击学完代替掌握", "width": 170, "yOffset": 118 },
    { "id": "growth", "lane": "evidence_lane", "col": 5, "type": "backend", "label": "能力画像与路径", "sublabel": "阶段、分支、里程碑与边界", "width": 166, "yOffset": 236 },
    { "id": "adapt", "lane": "trellis_lane", "col": 4, "type": "backend", "label": "动态调整提案", "sublabel": "推进 / 回看 / 缩小 / 补前置", "tag": "需确认才改路线", "width": 166, "yOffset": 128 }
  ],
  "edges": [
    { "id": "input-situation", "from": "learner", "to": "situation", "label": "模糊输入", "role": "main", "variant": "emphasis" },
    { "id": "input-sources", "from": "learner", "to": "sources", "label": "可选材料", "role": "branch", "variant": "dashed" },
    { "id": "situation-map", "from": "situation", "to": "map", "label": "目标与起点", "role": "main" },
    { "id": "sources-map", "from": "sources", "to": "map", "label": "拆解与映射", "role": "branch" },
    { "id": "map-package", "from": "map", "to": "package", "label": "优先级与前置", "role": "main", "variant": "emphasis" },
    { "id": "package-context", "from": "package", "to": "context", "label": "生成任务上下文", "role": "main" },
    { "id": "context-practice", "from": "context", "to": "practice", "label": "开始并练习", "role": "main" },
    { "id": "practice-evidence", "from": "practice", "to": "evidence", "label": "提交学习信号", "role": "main", "variant": "emphasis" },
    { "id": "evidence-growth", "from": "evidence", "to": "growth", "label": "形成能力证据", "role": "main" },
    { "id": "evidence-adapt", "from": "evidence", "to": "adapt", "label": "解释变化", "role": "branch", "variant": "dashed" },
    { "id": "adapt-package", "from": "adapt", "to": "package", "label": "调整下一任务", "role": "return", "route": "return-left", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "cyan", "title": "产品核心", "items": ["Trellis 编排知识点与能力任务，不把课程名称当作路线", "每周承诺围绕一个使命组织多个任务，而不是只推一张课程卡"] },
    { "dot": "emerald", "title": "学习连续性", "items": ["任务保留来源定位、上下文和中断恢复", "反馈要返回学到了什么、能力如何变化以及下一步为什么变化"] },
    { "dot": "rose", "title": "可信边界", "items": ["模型只产生候选判断，规则、证据和用户确认决定正式状态", "完成活动不等于能力已验证"] }
  ]
}
